SERVICE_NAME=patent-search-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

ENABLE_AUTH=true
API_TOKEN=
# Browser Console uses separate printable-ASCII HTTP Basic credentials.
# Never reuse API_TOKEN; CONSOLE_USERNAME must not contain a colon.
CONSOLE_USERNAME=
CONSOLE_PASSWORD=

# Administrator surface. Keep disabled until an authenticated private or
# loopback entry is available; public exposure requires separate network/TLS
# acceptance. These are new-deployment defaults; configure your own deployment. A shared
# Console credential is supported only as an explicit risk decision. The legacy
# VIEWER variable names are retained for deployment compatibility; this is the
# single administrator identity, not an RBAC role.
ADMIN_ENABLED=false
ADMIN_VIEWER_USERNAME=
ADMIN_VIEWER_PASSWORD=
# Draft writes remain separately disabled by default after code deployment.
ADMIN_CONFIG_DRAFTS_ENABLED=false
# A narrower, single-instance runtime-reload gate is also disabled by default. It
# never persists an override across process restart and cannot apply
# restart_required parameters.
ADMIN_RUNTIME_CONFIG_ENABLED=false
ADMIN_CONFIG_DATABASE_PATH=/var/lib/patent-search-service/admin-config.sqlite3
# Optional existing Prometheus base URL. The service executes fixed queries only.
ADMIN_PROMETHEUS_URL=
ADMIN_PROMETHEUS_JOB=patent-search
ADMIN_METRICS_TIMEOUT_SECONDS=2
# Production/default: native bounded reader for the patent-search journal
# namespace. Use process only as an explicit local-development fallback.
ADMIN_LOG_SOURCE=journal

# Deployment-provided release identity. Production acceptance must replace
# "unknown" with the deployed commit, tag, and non-secret instance identifier.
SERVICE_RELEASE_COMMIT=unknown
SERVICE_RELEASE_TAG=unknown
SERVICE_INSTANCE_ID=unknown

OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_HTTPS=true
OPENSEARCH_USER=admin
OPENSEARCH_PASS=
# Use the stable read alias; change its physical target only through the
# verified OpenSearch cutover workflow.
OPENSEARCH_INDEX=patent_search_read
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_TIMEOUT_SECONDS=240
OPENSEARCH_POOL_MAXSIZE=10
OPENSEARCH_MAX_RETRIES=1
OPENSEARCH_RETRY_BACKOFF_SECONDS=0.1
# Required at service startup. Fill all three with release-reviewed values;
# there are intentionally no code fallbacks for unapproved WIP candidates.
PATENT_SEARCH_BULKHEAD_CAPACITY=
PATENT_SEARCH_HEAVY_BULKHEAD_CAPACITY=
PATENT_SEARCH_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=
PATENT_SEARCH_DEADLINE_SECONDS=240
# Readiness is isolated from business traffic; cache bounds prevent probe storms.
READINESS_TIMEOUT_SECONDS=1
READINESS_SUCCESS_CACHE_SECONDS=2
READINESS_FAILURE_CACHE_SECONDS=1

# Query-vector provider. Use the singular endpoint for the current default model,
# or a JSON model-to-endpoint map for multiple models; never set both forms.
# API key and one endpoint form must be configured together. Semantic text and
# generated vectors must never be logged.
QUERY_VECTOR_API_URL=https://ark.cn-beijing.volces.com/api/v3/embeddings/multimodal
QUERY_VECTOR_API_KEY=
QUERY_VECTOR_MODEL_ENDPOINT=
QUERY_VECTOR_MODEL_ENDPOINTS={}

# Query-budget startup values. They may only tighten the code hard limits;
# invalid or higher values make startup fail rather than disabling protection.
QUERY_MAX_REQUEST_BODY_BYTES=16384
QUERY_MAX_CHARS=1000
QUERY_MAX_NESTING_DEPTH=32
QUERY_MAX_TOKENS=256
QUERY_MAX_AST_NODES=256
QUERY_MAX_BOOLEAN_CLAUSES=128
QUERY_MAX_PAGE_SIZE=100
QUERY_MAX_RESULT_WINDOW=10000

# Stage 10 SaaS PatentHub tool adapter.
PATENT_SEARCH_BASE_URL=http://127.0.0.1:8000
PATENT_SEARCH_API_TOKEN=
PATENT_SEARCH_USE_SELF_HOSTED=true
PATENT_SEARCH_PAGE_SIZE_LIMIT=50
PATENT_SEARCH_TIMEOUT_SECONDS=245

# Remote HTTP MCP server authentication.
MCP_ACCESS_TOKEN=
# MCP process-local worker cap. Calls above the cap fail fast with retryable 50301.
MCP_MAX_CONCURRENT_TOOLS=4

# Optional fallback to external PatentHub when PATENT_SEARCH_USE_SELF_HOSTED=false.
PATENTHUB_BASE_URL=https://www.patenthub.cn
PATENTHUB_API_TOKEN=
